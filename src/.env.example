# Use an OpenAI Chat Completions-compatible provider endpoint.
LLM_API_URL=https://your-provider.example/v1/chat/completions
LLM_API_KEY=put-your-secret-key-here
LLM_MODEL=your-chat-model-name
AI_PROXY_PORT=8787
# Local browser game defaults. Add your deployed site origin if hosted remotely.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
